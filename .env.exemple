# Copie ce fichier en .env pour changer les réglages.

# Date « d'aujourd'hui ». Les données de démo s'arrêtent le 15 octobre 2026.
# Laisse vide (MALIYA_AUJOURDHUI=) pour utiliser la vraie date avec tes propres données.
MALIYA_AUJOURDHUI=2026-10-15

# Ton prénom, pour le mot du matin
MALIYA_PRENOM=Wael

# Démarrer sans les données de démo :
# FLYWAY_LOCATIONS=classpath:db/migration

# LLM local (facultatif) : lance « docker compose --profile llm up » puis décommente
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=qwen2.5:3b

DB_PASSWORD=maliya
